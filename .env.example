# Copy to .env (gitignored) and fill in your tokens.
# .env is automatically loaded by docker-compose.

# Cloudflare API token (for deploying the Worker)
# Get from: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=

# GitHub Personal Access Token (alternative to running `gh auth login`)
# Get from: https://github.com/settings/personal-access-tokens
# Only needed if you want non-interactive git pushes from within the container.
GITHUB_TOKEN=

# WxWords admin token for upload moderation
# This was generated when the Worker was first set up — see Obsidian notes
WXWORDS_ADMIN_TOKEN=

# Optional: HuggingFace token for higher SegFormer download limits
HF_TOKEN=
