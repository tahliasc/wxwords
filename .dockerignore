# Large data files (not needed in image — mounted at runtime)
data/
models/*.keras
models/*.h5

# Build artifacts
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Editor / OS
.idea/
.vscode/
.DS_Store
*.swp

# Cloudflare / Wrangler
.wrangler/

# Git
.git/

# Notebooks checkpoints
.ipynb_checkpoints/

# Lock files for unrelated tools
.~lock.*

# Secrets — never bake into image
.env
